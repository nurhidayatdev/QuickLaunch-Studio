# Supabase PostgreSQL Connection URL (Transaction Mode / PgBouncer pada port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Session / Direct Mode pada port 5432 untuk migrasi tabel)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Secret Key untuk Enkripsi Token Sesi JWT (Gunakan string acak & aman)
JWT_SECRET="quicklaunch-production-jwt-secret-key-2026-secure"

# Email Administrator Utama (Akan otomatis memiliki peran Admin dan kuota tak terbatas)
ADMIN_EMAIL="admin@quicklaunch.id"

# Nomor WhatsApp Admin untuk Konfirmasi Pembayaran Pelanggan
ADMIN_WHATSAPP="081234567890"
